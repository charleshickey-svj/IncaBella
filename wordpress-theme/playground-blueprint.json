{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "login": true,
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/charleshickey-svj/IncaBella/refs/heads/claude/kind-cori-175nui/wordpress-theme/incabella-theme.zip"
      },
      "options": { "activate": true }
    },
    {
      "step": "setSiteOptions",
      "options": { "blogname": "IncaBella", "permalink_structure": "/%postname%/" }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; ib_do_setup();"
    }
  ]
}
